# Force pnpm as the package manager everywhere (Vercel, CI, local).
# This prevents the platform from falling back to `npm install`, which
# re-resolves native deps (sharp, onnxruntime-node, @xenova/transformers)
# to incompatible versions and breaks the build.
engine-strict=true
# Avoid optional-dependency resolution surprises for native modules.
auto-install-peers=true
# Hoist node_modules to avoid symlinked directory packages on Vercel/Lambda
node-linker=hoisted
